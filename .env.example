# Vercel-native Postgres (Neon) connection string.
# For production set DATABASE_URL in your Vercel project's Environment Variables
# (Neon is added via the Vercel Marketplace integration, which auto-injects this).
# For local dev, copy this file to .env and fill these in.
DATABASE_URL=postgres://user:password@host/db

# Admin CMS credentials.
ADMIN_EMAIL=admin@hashfuture.school
# Generate the hash with: npm run hash-password -- 'your-strong-password'
ADMIN_PASSWORD_HASH=scrypt:change-me

# Secret used to sign admin JWT tokens. Use a long random string (e.g. 32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret

# DeepSeek API key for the weekly automated blog generator.
# Get it from https://platform.deepseek.com/ and set it in Vercel's env too.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Newsletter delivery (Resend). Create an API key at https://resend.com/api-keys
# and add it to Vercel's env. The From address must use a verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
NEWSLETTER_FROM=Hash Future School <newsletter@hashfuture.school>

# Optional: where replies to the newsletter should land (must be verified).
NEWSLETTER_REPLY_TO=

# Canonical site URL used for unsubscribe links in the email footer.
NEWSLETTER_BASE_URL=https://www.hashfuture.school

# Optional: protects the /api/cron/generate-blog endpoint. Vercel sends this as
# a bearer token when you configure a CRON_SECRET for your project.
CRON_SECRET=

# Cookie options (optional). Defaults to secure cookies in production.
NODE_ENV=development
