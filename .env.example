# Vercel-native Postgres (Neon) connection string.
# For production set DATABASE_URL in your Vercel project's Environment Variables
# (Neon is added via the Vercel Marketplace integration, which auto-injects this).
# For local dev, copy this file to .env and fill these in.
DATABASE_URL=postgres://user:password@host/db

# Admin CMS credentials.
ADMIN_EMAIL=admin@hashfuture.school
# Generate the hash with: npm run hash-password -- 'your-strong-password'
ADMIN_PASSWORD_HASH=scrypt:change-me

# Secret used to sign admin JWT tokens. Use a long random string (e.g. 32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret

# Cookie options (optional). Defaults to secure cookies in production.
NODE_ENV=development
