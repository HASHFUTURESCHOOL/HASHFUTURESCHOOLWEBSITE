# Vercel-native Postgres (Neon) connection string.
# For production set DATABASE_URL in your Vercel project's Environment Variables
# (Neon is added via the Vercel Marketplace integration, which auto-injects this).
# For local dev, copy this file to .env and fill these in.
DATABASE_URL=postgres://user:password@host/db

# Admin CMS credentials.
ADMIN_EMAIL=admin@hashfuture.school
# Generate the hash with: npm run hash-password -- 'your-strong-password'
ADMIN_PASSWORD_HASH=scrypt:change-me

# Secret used to sign admin JWT tokens. Use a long random string (e.g. 32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret

# DeepSeek API key for the weekly automated blog generator.
# Get it from https://platform.deepseek.com/ and set it in Vercel's env too.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Email delivery (Mailgun) — newsletter, blog, and the /join pages all send
# through this. The key lives in Mailgun → Settings → API keys; it is the same
# account Future Assist uses. The domain must be verified in Mailgun, and the
# From address must sit on it.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=support.hashfuture.school
# "us" (default) or "eu" — must match the domain's region in Mailgun.
MAILGUN_REGION=us
# Optional display name/address for outgoing mail.
MAILGUN_FROM=Hash Future School <noreply@support.hashfuture.school>

# Optional: where replies to the newsletter should land (must be verified).
NEWSLETTER_REPLY_TO=

# --- Team applications (the /join page) -------------------------------------
# Where applications from /join are emailed. Comma-separate for several inboxes.
# Falls back to ADMIN_EMAIL, then learn@hashfuture.school.
TEAM_APPLICATIONS_TO=

# Endpoint in Future Assist that receives a copy of each application.
# Defaults to https://futureassist.hashfuture.school/api/join
# Set to off/disabled/none to skip the sync entirely (applications are then
# marked "disabled" rather than failing against a non-live endpoint).
FUTURE_ASSIST_JOIN_URL=

# --- Student Project Showcase (the /student-projects page) -------------------
# Where the showcase reads approved projects from. Defaults to
# https://futureassist.hashfuture.school/api/projects
# (it is also derived from FUTURE_ASSIST_JOIN_URL when that is set).
FUTURE_ASSIST_PROJECTS_URL=

# --- School Updates (the /school-updates page) -------------------------------
# The updates feed lives in the Future Assist storyboard
# (https://futureassist.hashfuture.school/storyboard), which is behind a login,
# so this page needs a readable source. Either point FUTURE_ASSIST_UPDATES_URL
# at a public read route, or set a bearer token below.
# Defaults to https://futureassist.hashfuture.school/api/storyboard
FUTURE_ASSIST_UPDATES_URL=
FUTURE_ASSIST_UPDATES_TOKEN=

# Canonical site URL used for unsubscribe links in the email footer.
NEWSLETTER_BASE_URL=https://www.hashfuture.school

# Optional: protects the /api/cron/generate-blog endpoint. Vercel sends this as
# a bearer token when you configure a CRON_SECRET for your project.
CRON_SECRET=

# Cookie options (optional). Defaults to secure cookies in production.
NODE_ENV=development
