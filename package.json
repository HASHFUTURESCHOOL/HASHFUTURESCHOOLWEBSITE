{
  "name": "hash-future-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hash Future School website with Vercel Postgres backend + Admin CMS",
  "scripts": {
    "hash-password": "node scripts/hash-password.js",
    "db:migrate": "node scripts/migrate.js",
    "dev": "node --env-file=.env scripts/dev-server.js",
    "build:global": "node scripts/build-global-pages.js",
    "check:global": "node scripts/check-global-pages.js",
    "build:city": "node scripts/build-city-pages.js",
    "check:city": "node scripts/check-city-pages.js",
    "check:claims": "node scripts/check-claims.js",
    "check:navigation": "node scripts/check-navigation.js",
    "seed:seo-posts": "node --env-file=.env scripts/seed-seo-posts.js",
    "build:pages": "npm run build:global && npm run build:city",
    "check:pages": "npm run check:global && npm run check:city && npm run check:claims && npm run check:navigation"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "postgres": "^3.4.9"
  }
}
