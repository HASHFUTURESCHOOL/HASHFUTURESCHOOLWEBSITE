{
    "cleanUrls": true,
    "trailingSlash": false,
    "framework": null,
    "crons": [
        {
            "path": "/api/cron/generate-blog",
            "schedule": "0 1 * * 1"
        },
        {
            "path": "/api/cron/send-newsletter",
            "schedule": "0 2 * * 1"
        }
    ],
    "rewrites": [
        {
            "source": "/api/proxy/admissions/demo",
            "destination": "https://futureassist.hashfuture.school/api/admissions/demo"
        },
        {
            "source": "/api/subscribe",
            "destination": "/api/newsletter/subscribe"
        },
        {
            "source": "/api/unsubscribe",
            "destination": "/api/newsletter/unsubscribe"
        },
        {
            "source": "/api/content",
            "destination": "/api/site-data/content"
        },
        {
            "source": "/api/posts",
            "destination": "/api/site-data/posts"
        }
    ],
    "redirects": [
        {
            "source": "/impactreports",
            "destination": "/impact-reports",
            "permanent": true
        },
        {
            "source": "/projects",
            "destination": "/student-projects",
            "permanent": false
        },
        {
            "source": "/updates",
            "destination": "/school-updates",
            "permanent": false
        }
    ]
}
